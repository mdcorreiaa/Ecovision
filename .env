# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA cometa o arquivo ".env" real no controle de versão.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-longa

# --- Banco de dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecovision
DB_USER=root
DB_PASSWORD=

# --- Reconhecimento facial ---
# Distância/confiança máxima aceita pelo LBPH (menor = mais rígido).
FACE_RECOGNITION_THRESHOLD=70
# Índice da câmera usada pelo OpenCV (normalmente 0 para webcam padrão)
CAMERA_INDEX=0

# --- Segurança de sessão ---
SESSION_LIFETIME_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
